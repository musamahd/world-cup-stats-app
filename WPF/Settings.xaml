<Window x:Class="WPF.Settings"
        
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        
        xmlns:local="clr-namespace:WPF"
        
        mc:Ignorable="d"
        Title="Settings" Height="350" Width="350" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        
        <StackPanel Margin="20">

            
            <TextBlock Text="Settings" FontSize="20" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,10"/>

            
            <TextBlock Name="tbWorldCup" Text="World Cup" FontWeight="Bold" TextAlignment="Center"/>
            <ComboBox Name="cmbWC"  Width="200">
                <ComboBoxItem x:Name="cmbMen" Content="{x:Static local:Resources.cmbMen}"/>
                <ComboBoxItem x:Name="cmbWomen" Content="{x:Static local:Resources.cmbWomen}"/>
            </ComboBox>

            
            <TextBlock x:Name="tbLanguage" Text="Language" FontWeight="Bold" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            <ComboBox Name="cmbLanguage" Width="200">
                <ComboBoxItem x:Name="cmbCroatian" Content="{x:Static local:Resources.cmbCroatian}"/>
                <ComboBoxItem  x:Name="cmbEnglish" Content="{x:Static local:Resources.cmbEnglish}"/>
            </ComboBox>

            
            <TextBlock Text="Size:" FontWeight="Bold" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <RadioButton Content="Fullscreen" x:Name="rbFullscreen" GroupName="WinSize"/>
                <RadioButton Content="1280x720" x:Name="rb1280" GroupName="WinSize"/>
                <RadioButton Content="800x600" x:Name="rb800" GroupName="WinSize"/>
            </StackPanel>

            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0" >
                <Button x:Name="btnSave" Click="btnSave_Click" Content="Save" Width="100" Margin="5"/>
                <Button x:Name="btnCancel" Content="Cancel" Width="100" Margin="5" />
            </StackPanel>
        </StackPanel>

    </Grid>
</Window>

<Window x:Class="WPF.PlayerStats"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF"
        mc:Ignorable="d"
        Title="PlayerStats" Height="300" Width="400" Loaded="Window_Loaded"  WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="15 0 0 0"/>
        </Style>
        <Storyboard x:Key="SlideInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.5" />
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="50" To="0" Duration="0:0:0.5" />
        </Storyboard>
    </Window.Resources>

    <Border x:Name="MainBorder" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TranslateTransform X="0" Y="50"/>
            
        </Border.RenderTransform>

        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30*"/>
            <ColumnDefinition Width="40*"/>
        </Grid.ColumnDefinitions>
        <TextBlock
    Grid.Row="0" 
    Grid.Column="0"
    Text="PICTURE:"/>
        <Image
    x:Name="imgPlayer"
            Source="/Images/hd-cristiano-ronaldo-portugal-player-celebration-png-701751712145282xwxjphiws4.png"
    Grid.Row="0" 
    Grid.Column="1"
    HorizontalAlignment="Left"
            Margin="15 0 0 0"
            />
        <TextBlock
    Grid.Row="1" 
    Grid.Column="0"
    Text="NAME:"/>
        <TextBlock
    x:Name="tbName"
    Grid.Row="1" 
    Grid.Column="1"
    Text="CR"/>
        <TextBlock
    Grid.Row="2" 
    Grid.Column="0"
    Text="NUMBER:"/>
        <TextBlock
    x:Name="tbNumber"
    Grid.Row="2" 
    Grid.Column="1"
    Text="7"/>
        <TextBlock
    Grid.Row="3" 
    Grid.Column="0"
    Text="POSITION:"/>
        <TextBlock
    x:Name="tbPosition"
    Grid.Row="3" 
    Grid.Column="1"
    Text="7"/>
        <TextBlock
    Grid.Row="4" 
    Grid.Column="0"
    Text="CAPTAIN:"/>
        <TextBlock
    x:Name="tbCaptain"
    Grid.Row="4" 
    Grid.Column="1"
    Text="Suii"/>
        <TextBlock
    Grid.Row="5" 
    Grid.Column="0"
    Text="GOALS:"/>
        <TextBlock
    x:Name="tbGoals"
    Grid.Row="5" 
    Grid.Column="1"
    Text="7"/>
        <TextBlock
    Grid.Row="6" 
    Grid.Column="0"
    Text="YELLOW CARDS:"/>
            <TextBlock
    x:Name="tbYellowCards"
    Grid.Row="6" 
    Grid.Column="1"
    Text="10"/>
        </Grid>
    </Border>
</Window>

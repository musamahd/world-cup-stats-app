<UserControl x:Class="WPF.Controls.PlayerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPF.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="120">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="120*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="20*"/>
        </Grid.RowDefinitions>
        <Button 
            x:Name="btnPlayer" 
            Height="80" 
            Width="80" 
            Background="Transparent" 
            Click="btnPlayer_Click">
        
            <Image x:Name="imgPlayer"
                   Grid.Row="0" 
                   Source="/Images/hd-cristiano-ronaldo-portugal-player-celebration-png-701751712145282xwxjphiws4.png"
                   Stretch="Fill"
                   />
        </Button>
        <TextBlock x:Name="tbShirtNumber"
                   Grid.Row="1"
                   FontSize="10"
                   Foreground="Red"
                   Text="27" 
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        <TextBlock x:Name="tbPlayer" 
                   Grid.Row="2" 
                   FontSize="10"
                   Foreground="Red"
                   Text="CR" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"/>
    </Grid>
</UserControl>

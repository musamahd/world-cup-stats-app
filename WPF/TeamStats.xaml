<Window x:Class="WPF.TeamStats"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF"
        mc:Ignorable="d"
        Title="TeamStats" Height="300" Width="300" Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen"
        >
    <Window.Resources>
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.5" />
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                             From="0.9" To="1" Duration="0:0:0.5" />
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                             From="0.9" To="1" Duration="0:0:0.5" />
        </Storyboard>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="15 0 0 0"/>
        </Style>
    </Window.Resources>
    <Grid x:Name="MainGrid" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*"/>
            <ColumnDefinition Width="50*"/>
        </Grid.ColumnDefinitions>
        <TextBlock
            Grid.Row="0" 
            Grid.Column="0"
            Text="TEAM:"/>
        <TextBlock
            x:Name="tbTeam"
            Grid.Row="0" 
            Grid.Column="1"
            Text="CROATIA"/>
        <TextBlock
            Grid.Row="1" 
            Grid.Column="0"
            Text="FIFA CODE:"/>
        <TextBlock
            x:Name="tbFIFAcode"
            Grid.Row="1" 
            Grid.Column="1"
            Text="CRO"/>
        <TextBlock
            Grid.Row="2" 
            Grid.Column="0"
            Text="MATCHES:"/>
        <TextBlock
            x:Name="tbMatches"
            Grid.Row="2" 
            Grid.Column="1"
            Text="8"/>
        <TextBlock
            Grid.Row="3" 
            Grid.Column="0"
            Text="WIN:"/>
        <TextBlock
            x:Name="tbWins"
            Grid.Row="3" 
            Grid.Column="1"
            Text="8"/>
        <TextBlock
            Grid.Row="4" 
            Grid.Column="0"
            Text="DRAW:"/>
        <TextBlock
            x:Name="tbDraws"
            Grid.Row="4" 
            Grid.Column="1"
            Text="0"/>
        <TextBlock
            Grid.Row="5" 
            Grid.Column="0"
            Text="LOST:"/>
        <TextBlock
            x:Name="tbLost"
            Grid.Row="5" 
            Grid.Column="1"
            Text="0"/>
        <TextBlock
            Grid.Row="6" 
            Grid.Column="0"
            Text="SCORED:"/>
        <TextBlock
            x:Name="tbScored"
            Grid.Row="6" 
            Grid.Column="1"
            Text="10"/> 
        <TextBlock
            Grid.Row="7" 
            Grid.Column="0"
            Text="CONCEDED:"/>
        <TextBlock
            x:Name="tbConceded"
            Grid.Row="7" 
            Grid.Column="1"
            Text="10"/>
        <TextBlock
            Grid.Row="8" 
            Grid.Column="0"
            Text="DIFFERENCE:"/>
        <TextBlock
            x:Name="tbDifference"
            Grid.Row="8" 
            Grid.Column="1"
            Text="10"/>
    </Grid>
</Window>
